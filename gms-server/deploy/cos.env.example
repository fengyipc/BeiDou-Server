# Copy to cos.env and fill in (cos.env is gitignored).
# Tencent COS: bucket name includes APPID, e.g. mybucket-1250000000

COS_BUCKET=mybucket-1250000000
COS_REGION=ap-guangzhou
# Optional: override auto endpoint cos.${COS_REGION}.myqcloud.com
# COS_ENDPOINT=cos.ap-guangzhou.myqcloud.com

# Object key prefix (no leading slash; trailing slash recommended), e.g. beidou/prod/
COS_PREFIX=beidou/

# If unset, coscli uses ~/.cos.yaml. For CI, set these (with --init-skip inside scripts):
# COS_SECRET_ID=
# COS_SECRET_KEY=

# Optional: space-separated resource roots for publish.sh (default below)
# RESOURCE_PATHS="scripts scripts-zh-CN wz wz-zh-CN"

# First publish only, when version.json does not exist on COS yet:
# INITIAL_FROM_COMMIT=0000000000000000000000000000000000000000

# Optional: custom coscli binary (otherwise scripts use `coscli` from PATH)
# COSCLI=/usr/local/bin/coscli
# COSCLI=$HOME/.local/bin/coscli
# Windows example: COSCLI=C:\Tools\coscli-windows-amd64\coscli.exe

# Windows: Python launcher (optional; scripts try python, python3, py -3)
# PYTHON=C:\Python311\python.exe

# run-with-update.sh / manual start
# BEIDOU_JAVA=/opt/jdk-21/bin/java
# BEIDOU_JAVA_OPTS=-Xms2G -Xmx4G

# Optional: state file location (default deploy/.beidou-deploy-state)
# BEIDOU_STATE_FILE=/opt/beidou-server/deploy/.beidou-deploy-state
